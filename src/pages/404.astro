---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Page introuvable — Martin Green`;
---

<Layout metadata={{ title, ignoreTitleTemplate: true }}>
  <section class="relative not-prose overflow-hidden">
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-20 md:pt-40 pb-20 md:pb-32 text-center">
      <p class="text-sm font-semibold tracking-[0.2em] uppercase mb-4" style="color: var(--aw-color-accent);">
        Erreur 404
      </p>
      <h1 class="font-heading font-bold text-7xl sm:text-8xl md:text-[10rem] leading-none tracking-tighter mb-6 text-gradient">
        404
      </h1>
      <p class="text-xl md:text-2xl font-semibold mb-3">
        Cette page s'est perdue dans les nuages.
      </p>
      <p class="text-base md:text-lg text-muted leading-relaxed mb-10 max-w-xl mx-auto">
        Le lien que tu suis est cassé, ou la page a été déplacée. Pas de panique — voici quelques portes pour rebondir.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <a href={getHomePermalink()} class="btn-primary group">
          <Icon name="tabler:home" class="w-4 h-4 mr-2" />
          <span>Retour à l'accueil</span>
        </a>
        <a href="/projets" class="btn-secondary group">
          <span>Voir les projets</span>
          <Icon name="tabler:arrow-up-right" class="w-4 h-4 ml-2 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
        </a>
      </div>

      <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-muted">
        <a href="/about" class="hover:opacity-100 opacity-70 transition-opacity">À propos</a>
        <span class="opacity-30">·</span>
        <a href="/articles" class="hover:opacity-100 opacity-70 transition-opacity">Articles</a>
        <span class="opacity-30">·</span>
        <a href="/boutique" class="hover:opacity-100 opacity-70 transition-opacity">Boutique</a>
        <span class="opacity-30">·</span>
        <a href="/contact" class="hover:opacity-100 opacity-70 transition-opacity">Contact</a>
      </div>
    </div>
  </section>
</Layout>
