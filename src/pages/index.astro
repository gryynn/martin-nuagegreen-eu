---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { projects } from '~/data/projects';

const metadata = {
  title: 'Martin Green — Maillon digital ↔ réel',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- HERO — bespoke glass + gradient -->
  <section class="relative not-prose overflow-hidden">
    <!-- Decorative orbs (subtle, behind content) -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-32 -left-20 w-72 h-72 rounded-full opacity-50"
           style="background: radial-gradient(circle, var(--aurora-1) 0%, transparent 70%); filter: blur(60px);">
      </div>
      <div class="absolute top-1/3 -right-24 w-96 h-96 rounded-full opacity-40"
           style="background: radial-gradient(circle, var(--aurora-2) 0%, transparent 70%); filter: blur(70px);">
      </div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-10 md:pt-32 pb-12 md:pb-24">
      <div class="text-center max-w-4xl mx-auto">
        <!-- Status pill -->
        <div class="flex justify-center mb-5 md:mb-8 motion-safe:animate-fade" style="animation-delay: 0.05s;">
          <span class="glass-pill">
            <span class="status-dot"></span>
            <span>Disponible · Paris</span>
            <span class="opacity-40">·</span>
            <span class="opacity-80">Freelance &amp; collaborations</span>
          </span>
        </div>

        <!-- Display heading -->
        <h1 class="font-heading font-bold text-[2.6rem] sm:text-6xl md:text-7xl lg:text-[5.5rem] leading-[1.05] tracking-tighter mb-6 motion-safe:animate-fade"
            style="animation-delay: 0.15s;">
          <span class="block">Maillon entre</span>
          <span class="text-gradient whitespace-nowrap">le digital</span>
          <span class="opacity-50 font-light">&amp;</span>
          <span class="text-gradient whitespace-nowrap">le réel</span>.
        </h1>

        <!-- Subtitle -->
        <p class="text-lg md:text-xl text-muted leading-relaxed max-w-2xl mx-auto mb-10 motion-safe:animate-fade"
           style="animation-delay: 0.3s;">
          Chef de projet ingénierie chez <strong class="text-default">Enedis</strong>.
          En parallèle, je teste agents IA, apps offline-first et objets imprimés en 3D —
          au croisement du numérique et de la matière.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16 motion-safe:animate-fade"
             style="animation-delay: 0.45s;">
          <a href="/projets" class="btn-primary group">
            <span>Voir les projets</span>
            <Icon name="tabler:arrow-up-right"
                  class="w-4 h-4 ml-2 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
          </a>
          <a href="/about" class="btn-secondary group">
            <span>À propos</span>
            <Icon name="tabler:arrow-up-right"
                  class="w-4 h-4 ml-2 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
          </a>
        </div>

        <!-- Mini stats / signal trio -->
        <div class="flex flex-wrap justify-center items-center gap-x-8 gap-y-3 text-sm text-muted motion-safe:animate-fade"
             style="animation-delay: 0.6s;">
          <span class="flex items-center gap-2">
            <Icon name="tabler:server-2" class="w-4 h-4 opacity-70" />
            <span>20+ services self-hostés</span>
          </span>
          <span class="opacity-30">/</span>
          <span class="flex items-center gap-2">
            <Icon name="tabler:robot" class="w-4 h-4 opacity-70" />
            <span>Agents IA en production</span>
          </span>
          <span class="opacity-30">/</span>
          <span class="flex items-center gap-2">
            <Icon name="tabler:device-mobile" class="w-4 h-4 opacity-70" />
            <span>Apps Flutter live</span>
          </span>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="hidden md:flex justify-center mt-16 motion-safe:animate-fade" style="animation-delay: 0.9s;">
        <a href="#projets" class="group flex flex-col items-center gap-2 text-muted hover:text-default transition-colors"
           aria-label="Aller aux projets">
          <span class="text-xs uppercase tracking-[0.2em]">Scroll</span>
          <Icon name="tabler:chevron-down" class="w-5 h-5 animate-bounce opacity-60 group-hover:opacity-100" />
        </a>
      </div>
    </div>
  </section>

  <!-- PROJETS — teaser avec cards cliquables vers /projets/[slug] -->
  <section id="projets" class="relative not-prose scroll-mt-[80px]">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20">
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase mb-3" style="color: var(--aw-color-accent);">
          Projets
        </p>
        <h2 class="font-heading font-bold text-4xl md:text-5xl leading-tight tracking-tighter mb-4">
          Ce que je construis
        </h2>
        <p class="text-lg md:text-xl text-muted leading-relaxed">
          Un écosystème personnel d'outils où data, agents IA et fabrication physique se rencontrent.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5 md:gap-6">
        {
          projects.map((p) => (
            <a href={`/projets/${p.slug}`} class="glass-card flex flex-col group cursor-pointer" style="text-decoration:none;color:inherit;">
              <div class="w-12 h-12 p-3 rounded-xl flex items-center justify-center mb-4"
                   style="background: var(--glass-bg-strong); border: 1px solid var(--glass-border);">
                <Icon name={p.icon} class="w-6 h-6" style="color: var(--aw-color-accent);" />
              </div>
              <h3 class="text-xl md:text-[1.35rem] font-bold mb-2 leading-tight">{p.title}</h3>
              <p class="text-base text-muted leading-relaxed mb-4 flex-1">{p.summary}</p>
              <div class="flex items-center gap-1.5 text-sm font-medium opacity-70 group-hover:opacity-100 transition-opacity"
                   style="color: var(--aw-color-accent);">
                <span>Voir le projet</span>
                <Icon name="tabler:arrow-up-right"
                      class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </div>
            </a>
          ))
        }
      </div>

      <div class="flex justify-center mt-10 md:mt-14">
        <a href="/projets" class="btn-secondary group">
          <span>Voir tous les projets &amp; filtres</span>
          <Icon name="tabler:arrow-right" class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- PARCOURS -->
  <Content
    id="parcours"
    tagline="Parcours"
    title="Du tangible au digital, et retour"
    items={[
      {
        title: 'Origine mécanique',
        description:
          "Bac STI2D mention TB, DUT GMP, Bachelor ENSAM Angers, ingénieur CESI. Trois ans en alternance chez Tetra Pak en gestion de projet industriel.",
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Pivot data + IA',
        description:
          "Apprentissage Enedis Service Transition Énergétique — plateforme de suivi des projets ENR avec Power BI et Supabase. Le déclic data.",
        icon: 'tabler:chart-line',
      },
      {
        title: "Construction d'un écosystème",
        description:
          "En parallèle, démarche de souveraineté numérique sur 2 ans : homelab, apps perso, agents IA, schémas data. La preuve par le faire.",
        icon: 'tabler:building',
      },
      {
        title: "Aujourd'hui",
        description:
          "CDI chef de projet ingénierie chez Enedis — pilotage des chantiers de renouvellement du réseau électrique. En continuité, je pousse l'idée que les startups IA ont besoin de profils qui font le pont vers le physique.",
        icon: 'tabler:point',
      },
    ]}
    image={{
      src: '~/assets/images/default.png',
      alt: 'Parcours Martin Green',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Mes valeurs de fond
      </h3>
      <p class="text-muted dark:text-slate-400 text-lg">
        <strong>Souveraineté · Liberté · Environnement.</strong> Avoir la main sur ses outils, garder le choix, construire avec ce qui dure.
      </p>
    </Fragment>
  </Content>

  <!-- COMPETENCES -->
  <Steps
    title="Ce que je sais faire"
    tagline="Compétences"
    items={[
      {
        title: 'Gestion de projet industriel',
        description: 'Lean 6 Sigma Green Belt, Waterfall (TPM), Agile. MS Project, Fibery, Excel avancé. Toute ma carrière.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Data et IA appliquée',
        description: 'PostgreSQL/Supabase (10+ schémas en prod), Power BI, Python, n8n, MCP servers, RAG/Qdrant, agents Claude/Kimi.',
        icon: 'tabler:database',
      },
      {
        title: 'Self-hosting et souveraineté',
        description: 'Docker (20+ services), Linux, Traefik, accès distant chiffré. Homelab et apps personnelles intégrées.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Hardware DIY',
        description: 'Fusion 360, Blender, impression 3D, ESP32/Arduino, hydroponie, conception mécanique générale.',
        icon: 'tabler:tools',
      },
      {
        title: 'Langues',
        description: 'Français natif. Anglais C1 (TOEIC 945). Espagnol B2. Allemand notions.',
        icon: 'tabler:world',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- ARTICLES -->
  <BlogLatestPosts
    id="articles"
    title="Articles récents"
    information={`Notes longues sur ce que je construis et ce que j'apprends.`}
  />

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Me contacter',
        href: '/contact',
        icon: 'tabler:mail',
      },
      {
        text: 'GitHub',
        href: 'https://github.com/gryynn',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">Une idée à pousser ensemble ?</Fragment>
    <Fragment slot="subtitle">
      Freelance, collaboration, candidature, side-project — j'ai un appétit large.
      Le plus simple : un mail ou un message LinkedIn.
    </Fragment>
  </CallToAction>
</Layout>
