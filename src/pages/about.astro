---
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'À propos',
};
---

<Layout metadata={metadata}>
  <!-- HERO -->
  <Hero
    tagline="À propos"
  >
    <Fragment slot="title">
      Ingénieur méca de formation, <br />
      <span class="text-accent dark:text-white">je connecte IA appliquée et fabrication concrète.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Je m'appelle Martin Green, j'ai grandi en Saône-et-Loire, je vis et travaille à Paris.
      Sur le papier je suis chef de projet ingénierie dans le service public de l'énergie. Hors du papier, j'occupe un endroit que peu de gens habitent : le maillon entre le numérique et le réel.
    </Fragment>
  </Hero>

  <!-- NARRATIVE -->
  <Content
    isReversed
    tagline="Le récit"
    title="Pourquoi ce profil hybride existe"
    items={[
      {
        title: 'Le tangible d\'abord',
        description: 'Bac STI2D mention TB à Cluny, DUT GMP à Angers, Bachelor ENSAM. Au lycée j\'ai monté un club de skate et financé sa rampe. À Angers j\'ai présidé le BDE. J\'aime les choses concrètes — les gens, les engins, les pièces qui s\'emboîtent.',
      },
      {
        title: 'La mécanique en pratique',
        description: 'Trois ans en alternance chez Tetra Pak Dijon en gestion de projet industriel : installation de machines, méthode TPM, développement d\'un chariot de transport pour réduire les TMS. Mobilité 3 mois en Italie. C\'est là que j\'ai appris à piloter des chantiers complexes.',
      },
      {
        title: 'Le déclic data',
        description: 'Apprentissage Enedis Service Transition Énergétique : développement d\'une plateforme de suivi des projets ENR avec les acteurs territoriaux (DREAL, SRADDET, Préfecture). Power BI, Supabase, Agile. Première fois que je vois ce que la donnée bien pensée peut transformer.',
      },
      {
        title: 'En parallèle, l\'écosystème perso',
        description: 'En 2 ans j\'ai construit en autodidacte (avec l\'IA générative comme levier) tout un écosystème : homelab personnel, apps mobiles (NOMAD, Mirai), agent IA local Hermès, une dizaine de schémas Supabase qui pilotent mon quotidien. La preuve par le faire d\'une démarche de souveraineté numérique appliquée.',
      },
      {
        title: 'Aujourd\'hui',
        description: 'CDI chef de projet ingénierie en région parisienne — pilotage des chantiers de renouvellement du réseau électrique. En parallèle, j\'expérimente le pivot vers l\'IA appliquée et la robotique DIY.',
      },
    ]}
  />

  <!-- VALEURS -->
  <Steps2
    title="Mes valeurs de fond"
    subtitle="Trois fils qui orientent ce que je construis et ce que je teste."
    items={[
      {
        title: 'Souveraineté',
        description: 'Avoir la main sur mes outils et mes données. Privilégier l\'open-source et les briques européennes — pas par dogme, parce que ça tient mieux sur la durée. Comprendre la stack quand c\'est possible, savoir où sont les dépendances quand ça ne l\'est pas.',
      },
      {
        title: 'Liberté',
        description: 'Choisir mes contraintes plutôt que les subir. Garder la possibilité de changer d\'outil, de fournisseur, de cap. Le contraire du verrouillage — pour soi comme pour les organisations qu\'on construit.',
      },
      {
        title: 'Environnement',
        description: 'Construire avec ce qui existe déjà, durer, faire local quand c\'est possible. La sobriété tech comme ambition tranquille, pas comme privation. Ce site tourne sur un domaine en .eu pour une raison.',
      },
    ]}
  />

  <!-- COMPLÉMENTAIRE -->
  <Stats
    title="Quelques chiffres"
    stats={[
      { title: 'Services Docker auto-hébergés', amount: '20+' },
      { title: 'Schémas Supabase en prod', amount: '10+' },
      { title: 'Notes atomiques dans le vault', amount: '300+' },
      { title: 'TOEIC anglais', amount: '945' },
    ]}
  />

  <!-- ATTENTION DOMAINES -->
  <Content
    tagline="Centres d'intérêt"
    title="Ce qui m'occupe en dehors du job"
    items={[
      {
        title: 'IA appliquée et agents autonomes',
        description: 'Je suis particulièrement intéressé par les architectures d\'agents (LangGraph, MCP, RAG), les world models (JEPA), et la question de comment rendre les LLM réellement utiles au quotidien.',
        icon: 'tabler:robot',
      },
      {
        title: 'Robotique DIY et impression 3D',
        description: 'Côté physique, j\'aime construire — Arduino, ESP32, modélisation Fusion 360 et Blender, impression 3D. Mon side-project MG Design est né de là.',
        icon: 'tabler:tools',
      },
      {
        title: 'Souveraineté numérique européenne',
        description: 'Sujet qui me tient à cœur. Je ne suis pas hermite — mon téléphone tourne sous Android, j\'utilise la suite Microsoft au boulot. Mais je pense que les entreprises européennes vont devoir mieux maîtriser leurs dépendances tech dans les années à venir, et que les solutions open-source ont une vraie carte à jouer. Je teste, j\'expérimente, je documente.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Pilotage perso et PKM',
        description: 'Vault Obsidian, schémas Supabase, dashboards data-oriented. J\'aime tester sur moi les outils que je voudrais voir tourner ailleurs — agent IA local, capture audio, time-tracking fractal. Bench R&D personnel pour comprendre ce qui marche et ce qui ne marche pas.',
        icon: 'tabler:dashboard',
      },
    ]}
  />

  <!-- CTA CONTACT -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Me contacter',
        href: '/contact',
        icon: 'tabler:mail',
      },
      {
        text: 'Mon LinkedIn',
        href: 'https://www.linkedin.com/in/martingreenfrance',
        target: '_blank',
        icon: 'tabler:brand-linkedin',
      },
    ]}
  >
    <Fragment slot="title">Envie d'en parler ?</Fragment>
    <Fragment slot="subtitle">
      Que ce soit pour discuter d'IA appliquée, d'un projet de robotique, d'un side-project, ou juste pour échanger — la porte est ouverte.
    </Fragment>
  </CallToAction>
</Layout>
