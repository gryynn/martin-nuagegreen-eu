---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { projects, allTags } from '~/data/projects';

const metadata = {
  title: 'Projets — Martin Green',
};

const statusLabel = {
  live: 'Live',
  wip: 'En cours',
  concept: 'Concept',
  archived: 'Archivé',
};
---

<Layout metadata={metadata}>
  <section class="relative not-prose overflow-hidden">
    <!-- Decorative orbs -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-32 -left-20 w-72 h-72 rounded-full opacity-50"
           style="background: radial-gradient(circle, var(--aurora-1) 0%, transparent 70%); filter: blur(60px);"></div>
      <div class="absolute top-1/3 -right-24 w-96 h-96 rounded-full opacity-40"
           style="background: radial-gradient(circle, var(--aurora-2) 0%, transparent 70%); filter: blur(70px);"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-10 md:pt-32 pb-12 md:pb-20">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-10 md:mb-16">
        <p class="text-sm font-semibold tracking-[0.2em] uppercase mb-4" style="color: var(--aw-color-accent);">
          Projets
        </p>
        <h1 class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl leading-[1.05] tracking-tighter mb-4">
          Ce que je <span class="text-gradient">construis</span>.
        </h1>
        <p class="text-lg md:text-xl text-muted leading-relaxed">
          Un écosystème personnel d'outils — où data, agents IA et fabrication physique se rencontrent.
        </p>
      </div>

      <!-- Filter chips -->
      <div class="flex flex-wrap justify-center gap-2 mb-10 md:mb-14" id="filter-chips">
        <button
          type="button"
          data-filter="all"
          class="filter-chip glass-pill is-active"
        >
          <span>Tous</span>
          <span class="opacity-50 text-xs ml-1">{projects.length}</span>
        </button>
        {
          allTags.map((tag) => {
            const count = projects.filter((p) => p.tags.includes(tag)).length;
            return (
              <button type="button" data-filter={tag} class="filter-chip glass-pill">
                <span>#{tag}</span>
                <span class="opacity-50 text-xs ml-1">{count}</span>
              </button>
            );
          })
        }
      </div>

      <!-- Projects grid -->
      <div id="projects-grid" class="grid sm:grid-cols-2 gap-5 md:gap-6">
        {
          projects.map((p) => (
            <a
              href={`/projets/${p.slug}`}
              class="project-card glass-card flex flex-col group cursor-pointer no-underline"
              data-tags={p.tags.join(' ')}
            >
              <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 p-3 rounded-xl flex items-center justify-center"
                     style="background: var(--glass-bg-strong); border: 1px solid var(--glass-border);">
                  <Icon name={p.icon} class="w-6 h-6" style="color: var(--aw-color-accent);" />
                </div>
                <div class="flex items-center gap-2 text-xs">
                  <span
                    class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full"
                    style={`background: ${p.status === 'live' ? 'rgba(45,106,79,0.15)' : 'var(--glass-bg)'}; color: ${p.status === 'live' ? 'var(--aw-color-accent)' : 'var(--aw-color-text-muted)'};`}
                  >
                    {p.status === 'live' && <span class="w-1.5 h-1.5 rounded-full bg-current" />}
                    {statusLabel[p.status]}
                  </span>
                  <span class="text-muted opacity-70">{p.year}</span>
                </div>
              </div>

              <h2 class="text-xl md:text-[1.35rem] font-bold mb-2 leading-tight">
                {p.title}
              </h2>
              <p class="text-sm text-muted mb-4 leading-relaxed">{p.tagline}</p>

              <p class="text-base leading-relaxed mb-5 flex-1">{p.summary}</p>

              <div class="flex flex-wrap gap-1.5 mb-5">
                {p.tags.map((tag) => (
                  <span class="text-xs px-2 py-0.5 rounded-full"
                        style="background: var(--glass-bg); color: var(--aw-color-text-muted); border: 1px solid var(--glass-border);">
                    #{tag}
                  </span>
                ))}
              </div>

              <div class="flex items-center justify-between text-sm font-medium pt-4 mt-auto"
                   style="border-top: 1px solid var(--glass-border);">
                <span class="opacity-70 group-hover:opacity-100 transition-opacity">Voir le projet</span>
                <Icon name="tabler:arrow-up-right"
                      class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      style="color: var(--aw-color-accent);" />
              </div>
            </a>
          ))
        }
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-16 text-muted">
        Aucun projet ne correspond à ces filtres.
      </div>
    </div>
  </section>
</Layout>

<style is:inline>
  .filter-chip {
    cursor: pointer;
    transition: all 200ms ease-out;
    user-select: none;
  }
  .filter-chip:hover {
    transform: translateY(-1px);
  }
  .filter-chip.is-active {
    background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
    color: #FAFAF7;
    border-color: transparent;
  }
  .dark .filter-chip.is-active {
    color: #050807;
  }
  .filter-chip.is-active span {
    opacity: 1 !important;
  }
  .project-card {
    text-decoration: none;
    color: inherit;
  }
  .project-card.is-hidden {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    if (window.__mgProjectFilters) return;
    window.__mgProjectFilters = true;

    function init() {
      const chips = document.querySelectorAll('#filter-chips .filter-chip');
      const cards = document.querySelectorAll('#projects-grid .project-card');
      const empty = document.getElementById('empty-state');
      const grid = document.getElementById('projects-grid');
      if (!chips.length || !cards.length) return;

      const active = new Set(['all']);

      function apply() {
        let visible = 0;
        cards.forEach((card) => {
          const tags = (card.dataset.tags || '').split(' ').filter(Boolean);
          let show = active.has('all');
          if (!show) {
            for (const t of tags) {
              if (active.has(t)) {
                show = true;
                break;
              }
            }
          }
          card.classList.toggle('is-hidden', !show);
          if (show) visible++;
        });
        if (empty && grid) {
          empty.classList.toggle('hidden', visible > 0);
          grid.classList.toggle('hidden', visible === 0);
        }
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const f = chip.dataset.filter;
          if (!f) return;
          if (f === 'all') {
            active.clear();
            active.add('all');
          } else {
            active.delete('all');
            if (active.has(f)) active.delete(f);
            else active.add(f);
            if (active.size === 0) active.add('all');
          }
          chips.forEach((c) => c.classList.toggle('is-active', active.has(c.dataset.filter)));
          apply();
        });
      });
    }

    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
  })();
</script>
