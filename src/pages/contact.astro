---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};

interface ContactCard {
  title: string;
  description: string;
  icon: string;
  href?: string;
  external?: boolean;
}

const contactCards: ContactCard[] = [
  {
    title: 'Email',
    description: 'contact@nuagegreen.eu',
    icon: 'tabler:mail',
    href: 'mailto:contact@nuagegreen.eu',
  },
  {
    title: 'LinkedIn',
    description: 'linkedin.com/in/martingreenfrance',
    icon: 'tabler:brand-linkedin',
    href: 'https://www.linkedin.com/in/martingreenfrance',
    external: true,
  },
  {
    title: 'GitHub',
    description: 'github.com/gryynn',
    icon: 'tabler:brand-github',
    href: 'https://github.com/gryynn',
    external: true,
  },
  {
    title: 'Localisation',
    description: 'Paris, France',
    icon: 'tabler:map-pin',
    // [TODO] href vers une carte interactive (Leaflet / plugin Obsidian map) — Phase 3
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Discutons"
    subtitle="Le plus simple : email ou LinkedIn. Je réponds en général dans les 48h."
  />

  <!-- Cards de contact cliquables -->
  <section class="relative not-prose">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
      <h2 class="font-heading font-bold text-3xl md:text-4xl tracking-tighter text-center mb-10">
        Où me joindre
      </h2>
      <div class="grid sm:grid-cols-2 gap-5 md:gap-6 max-w-4xl mx-auto">
        {
          contactCards.map((c) => {
            const Tag = c.href ? 'a' : 'div';
            const linkProps = c.href
              ? {
                  href: c.href,
                  target: c.external ? '_blank' : undefined,
                  rel: c.external ? 'noopener noreferrer' : undefined,
                }
              : {};
            return (
              <Tag
                {...linkProps}
                class={`glass-card flex flex-col group ${c.href ? 'cursor-pointer no-underline color-inherit' : ''}`}
              >
                <div
                  class="w-14 h-14 p-3 rounded-xl flex items-center justify-center mb-5"
                  style="background: var(--glass-bg-strong); border: 1px solid var(--glass-border);"
                >
                  <Icon name={c.icon} class="w-7 h-7" style="color: var(--aw-color-accent);" />
                </div>
                <h3 class="text-xl font-bold mb-1 leading-tight">{c.title}</h3>
                <p class="text-base text-muted leading-relaxed">{c.description}</p>
                {c.href && (
                  <div
                    class="flex items-center gap-1.5 text-sm font-medium mt-4 opacity-60 group-hover:opacity-100 transition-opacity"
                    style="color: var(--aw-color-accent);"
                  >
                    <span>Ouvrir</span>
                    <Icon
                      name="tabler:arrow-up-right"
                      class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    />
                  </div>
                )}
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <Features2
    title="Pour quoi me contacter ?"
    columns={2}
    items={[
      {
        title: 'Side-project ou collaboration',
        description: 'Idée à pousser ensemble, projet open-source à co-construire, expérimentation IA / hardware. Toujours preneur.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Mission courte IA appliquée',
        description: 'Agents, MCP, intégrations data, automatisation. Au cas par cas, quand le sujet a du sens et que je peux apporter de la valeur.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Recrutement',
        description: 'Si tu cherches un profil maillon digital ↔ réel pour ton équipe IA appliquée ou industrielle, parlons-en.',
        icon: 'tabler:user-search',
      },
      {
        title: 'MG Design (impression 3D)',
        description: 'Pour des objets sur-mesure (trophées, prototypes), passe par mgdesign.cloud avec mon associé.',
        icon: 'tabler:3d-cube-sphere',
      },
    ]}
  />
</Layout>

<style is:inline>
  .color-inherit {
    color: inherit;
    text-decoration: none;
  }
</style>
