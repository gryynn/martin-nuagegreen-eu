---
import { Icon } from 'astro-icon/components';

export interface Slide {
  src: string;
  alt: string;
  caption?: string;
}

export interface Props {
  slides: Slide[];
  id?: string;
  aspectRatio?: string;
}

const { slides, id = `carousel-${Math.random().toString(36).slice(2, 9)}`, aspectRatio = '16/10' } = Astro.props;
---

{
  slides.length > 0 && (
    <div class="mg-carousel" id={id} data-mg-carousel data-count={slides.length}>
      <div class="mg-carousel-track" role="list">
        {slides.map((s, i) => (
          <figure class="mg-carousel-slide" role="listitem" data-index={i} style={`aspect-ratio: ${aspectRatio};`}>
            <img src={s.src} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} />
            {s.caption && <figcaption class="mg-carousel-caption">{s.caption}</figcaption>}
          </figure>
        ))}
      </div>

      {slides.length > 1 && (
        <>
          <button type="button" class="mg-carousel-btn mg-carousel-prev" aria-label="Image précédente" data-dir="-1">
            <Icon name="tabler:chevron-left" class="w-5 h-5" />
          </button>
          <button type="button" class="mg-carousel-btn mg-carousel-next" aria-label="Image suivante" data-dir="1">
            <Icon name="tabler:chevron-right" class="w-5 h-5" />
          </button>

          <div class="mg-carousel-dots" role="tablist">
            {slides.map((_, i) => (
              <button
                type="button"
                class:list={['mg-carousel-dot', { 'is-active': i === 0 }]}
                data-index={i}
                aria-label={`Aller à l'image ${i + 1}`}
              />
            ))}
          </div>
        </>
      )}
    </div>
  )
}

<style is:inline>
  .mg-carousel {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
  }
  .mg-carousel-track {
    display: flex;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .mg-carousel-slide {
    flex: 0 0 100%;
    margin: 0;
    position: relative;
    overflow: hidden;
  }
  .mg-carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .mg-carousel-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: #fff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    pointer-events: none;
  }

  .mg-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: var(--glass-bg-strong);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    border: 1px solid var(--glass-border);
    color: var(--aw-color-text-default);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.9;
    transition: opacity 200ms, transform 200ms;
    z-index: 2;
  }
  .mg-carousel-btn:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.05);
  }
  .mg-carousel-prev { left: 0.75rem; }
  .mg-carousel-next { right: 0.75rem; }

  .mg-carousel-dots {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    z-index: 2;
  }
  .mg-carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.5);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 200ms;
  }
  .mg-carousel-dot.is-active {
    width: 24px;
    background: var(--aw-color-accent);
  }
</style>

<script is:inline>
  (function () {
    if (window.__mgCarouselInit) return;
    window.__mgCarouselInit = true;

    function init() {
      document.querySelectorAll('[data-mg-carousel]').forEach((root) => {
        if (root.dataset.bound === '1') return;
        root.dataset.bound = '1';

        const track = root.querySelector('.mg-carousel-track');
        const count = parseInt(root.dataset.count || '1', 10);
        const dots = root.querySelectorAll('.mg-carousel-dot');
        let index = 0;

        function go(i) {
          index = ((i % count) + count) % count;
          track.style.transform = `translateX(-${index * 100}%)`;
          dots.forEach((d, di) => d.classList.toggle('is-active', di === index));
        }

        root.querySelectorAll('[data-dir]').forEach((btn) => {
          btn.addEventListener('click', () => go(index + parseInt(btn.dataset.dir, 10)));
        });
        dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

        // Touch swipe
        let touchX = null;
        track.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
        track.addEventListener('touchend', (e) => {
          if (touchX === null) return;
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
          touchX = null;
        }, { passive: true });

        // Keyboard
        root.tabIndex = 0;
        root.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') go(index - 1);
          else if (e.key === 'ArrowRight') go(index + 1);
        });
      });
    }

    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
  })();
</script>
