---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative not-prose mt-12 md:mt-20" style="border-top: 1px solid var(--glass-border);">
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    <div class="grid grid-cols-12 gap-6 md:gap-8 mb-8">
      <!-- Brand -->
      <div class="col-span-12 md:col-span-5">
        <a class="inline-flex items-center mb-3" href={getHomePermalink()} aria-label="Accueil">
          <Logo />
        </a>
        <p class="text-sm text-muted leading-relaxed max-w-sm">
          Maillon entre digital et réel — agents IA, apps offline-first, fabrication 3D.
          Site fait main avec Astro, pile dans le mantra : souveraineté, liberté, puissance.
        </p>
      </div>

      <!-- Link columns -->
      {
        links.map(({ title, links: cols }) => (
          <div class="col-span-6 md:col-span-2">
            <div class="font-semibold mb-3 text-sm uppercase tracking-wider" style="color: var(--aw-color-accent);">
              {title}
            </div>
            {cols && cols.length > 0 && (
              <ul class="text-sm space-y-2">
                {cols.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted hover:text-default transition-colors"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5 pt-6"
         style="border-top: 1px solid var(--glass-border);">
      {
        socialLinks?.length > 0 && (
          <ul class="flex gap-1">
            {socialLinks.map(({ ariaLabel, href, icon }) => (
              <li>
                <a
                  class="inline-flex items-center justify-center w-9 h-9 rounded-full hover:bg-[var(--glass-bg)] transition-colors"
                  aria-label={ariaLabel}
                  href={href}
                  target={href?.startsWith('http') ? '_blank' : undefined}
                  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="text-xs text-muted flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>© {year} {SITE?.name || 'Martin Green'}</span>
        {
          secondaryLinks.map(({ text, href }) => (
            <>
              <span class="opacity-40">·</span>
              <a class="hover:text-default transition-colors" href={href} set:html={text} />
            </>
          ))
        }
      </div>
    </div>

    {
      footNote && (
        <div class="mt-6 text-xs text-muted opacity-80 leading-relaxed">
          <Fragment set:html={footNote} />
        </div>
      )
    }
  </div>
</footer>
