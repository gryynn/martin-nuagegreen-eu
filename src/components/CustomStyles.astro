---
import '@fontsource-variable/inter';
---

<!-- Fonts: Archivo (display) + Space Grotesk (body) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
/>

<style is:inline>
  :root {
    --aw-font-sans: 'Space Grotesk', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Space Grotesk', 'Inter Variable', ui-serif, serif;
    --aw-font-heading: 'Archivo', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;

    /* Palette light — off-white + ink black + deep forest */
    --aw-color-primary: rgb(27 67 50);          /* #1B4332 forest deep */
    --aw-color-secondary: rgb(15 42 31);        /* #0F2A1F charcoal-green */
    --aw-color-accent: rgb(45 106 79);          /* #2D6A4F brighter forest */

    --aw-color-text-heading: rgb(10 15 13);     /* #0A0F0D near-black */
    --aw-color-text-default: rgb(20 28 25);     /* #141C19 */
    --aw-color-text-muted: rgb(74 85 82 / 88%); /* #4A5552 warm grey */
    --aw-color-bg-page: rgb(250 250 247);       /* #FAFAF7 warm off-white */
    --aw-color-bg-page-dark: rgb(5 8 7);        /* #050807 near-black */

    /* Glass tokens */
    --glass-bg: rgba(255, 255, 255, 0.55);
    --glass-bg-strong: rgba(255, 255, 255, 0.78);
    --glass-border: rgba(15, 42, 31, 0.10);
    --glass-shadow: 0 10px 40px -10px rgba(15, 42, 31, 0.18);
    --glass-blur: 18px;

    /* Aurora backdrop colors — strong enough to read on off-white bg */
    --aurora-1: rgba(45, 106, 79, 0.75);
    --aurora-2: rgba(110, 231, 183, 0.65);
    --aurora-3: rgba(27, 67, 50, 0.55);

    /* Gradient highlight */
    --grad-start: #1B4332;
    --grad-end: #2D6A4F;

    ::selection {
      background-color: rgba(45, 106, 79, 0.25);
      color: #0A0F0D;
    }
  }

  .dark {
    --aw-color-primary: rgb(52 211 153);          /* #34D399 emerald */
    --aw-color-secondary: rgb(16 185 129);        /* #10B981 */
    --aw-color-accent: rgb(110 231 183);          /* #6EE7B7 mint glow */

    --aw-color-text-heading: rgb(232 237 233);    /* #E8EDE9 */
    --aw-color-text-default: rgb(220 226 222);
    --aw-color-text-muted: rgb(156 168 162 / 92%); /* #9CA8A2 */
    --aw-color-bg-page: rgb(5 8 7);

    /* Glass tokens — dark */
    --glass-bg: rgba(15, 25, 20, 0.45);
    --glass-bg-strong: rgba(10, 18, 14, 0.78);
    --glass-border: rgba(110, 231, 183, 0.12);
    --glass-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
    --glass-blur: 22px;

    /* Aurora — dark — visible on near-black bg */
    --aurora-1: rgba(52, 211, 153, 0.55);
    --aurora-2: rgba(16, 185, 129, 0.50);
    --aurora-3: rgba(110, 231, 183, 0.45);

    --grad-start: #6EE7B7;
    --grad-end: #34D399;

    ::selection {
      background-color: rgba(52, 211, 153, 0.30);
      color: #E8EDE9;
    }
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--aw-color-bg-page);
  }

  body {
    font-family: var(--aw-font-sans);
    font-feature-settings: 'ss01', 'cv11';
    -webkit-font-smoothing: antialiased;
    background-color: transparent !important;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--aw-font-heading);
    letter-spacing: -0.02em;
  }
</style>
