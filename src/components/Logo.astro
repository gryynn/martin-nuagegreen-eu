---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2 self-center">
  <svg
    aria-hidden="true"
    class="mg-logo-cloud w-7 h-7 shrink-0"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    fill="currentColor"
  >
    <path
      d="M10.04 4.305c2.195 -.667 4.615 -.224 6.36 1.176c1.6 1.282 2.493 3.149 2.55 5.117l.01 .07l.062 .005a4.21 4.21 0 0 1 3.95 3.84l.01 .2l.013 .25c0 2.317 -1.804 4.197 -4.05 4.197h-13.5c-2.578 -.038 -4.45 -1.991 -4.45 -4.45c0 -1.713 .92 -3.225 2.327 -4.054l.122 -.067l-.005 -.126a5.55 5.55 0 0 1 3.428 -5.39l.215 -.083l.157 -.054z"
    />
  </svg>

  <span
    class="ml-0 rtl:ml-0 rtl:mr-2 text-xl md:text-lg font-mono font-semibold tracking-tight text-gray-900 dark:text-white whitespace-nowrap"
  >
    {SITE?.name}
  </span>
</span>

<style is:inline>
  .mg-logo-cloud {
    color: var(--aw-color-accent);
    filter: drop-shadow(0 1px 4px rgba(45, 106, 79, 0.3));
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1), filter 350ms ease;
  }
  a:hover .mg-logo-cloud,
  .group:hover .mg-logo-cloud {
    transform: translateY(-1px) rotate(-3deg);
    filter: drop-shadow(0 3px 8px rgba(52, 211, 153, 0.5));
  }
  .dark .mg-logo-cloud {
    filter: drop-shadow(0 1px 6px rgba(52, 211, 153, 0.4));
  }
  .dark a:hover .mg-logo-cloud,
  .dark .group:hover .mg-logo-cloud {
    filter: drop-shadow(0 3px 10px rgba(110, 231, 183, 0.65));
  }
</style>
